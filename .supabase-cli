#!/bin/bash

# Supabase CLI Convenience Script
# Save your connection string here for easy access

# ⚠️ IMPORTANT: This file contains your database password
# Add to .gitignore to prevent accidental commit
# NEVER commit this to version control!

export SUPABASE_DB_URL="postgresql://postgres:Tharun%409381@db.gtdpxovwszdhapszuacs.supabase.co:5432/postgres"
export SUPABASE_PROJECT="whopp-health-tracker"
export SUPABASE_HOST="db.gtdpxovwszdhapszuacs.supabase.co"

# Quick aliases
alias supabase-db="psql '$SUPABASE_DB_URL'"

# Functions for common tasks
function supabase-tables() {
  psql "$SUPABASE_DB_URL" -c "\dt"
}

function supabase-query() {
  psql "$SUPABASE_DB_URL" -c "$1"
}

function supabase-users() {
  psql "$SUPABASE_DB_URL" -c "SELECT id, email, full_name, timezone, created_at FROM users LIMIT 10;"
}

function supabase-providers() {
  psql "$SUPABASE_DB_URL" -c "SELECT user_id, provider_name, is_primary, is_active, connected_at FROM user_health_providers;"
}

function supabase-metrics-count() {
  psql "$SUPABASE_DB_URL" -c "SELECT COUNT(*) as total_metrics FROM health_metrics;"
}

function supabase-messages() {
  psql "$SUPABASE_DB_URL" -c "SELECT user_id, DATE(date), message, delivery_status FROM ai_generated_messages ORDER BY date DESC LIMIT 20;"
}

function supabase-analytics() {
  psql "$SUPABASE_DB_URL" -c "SELECT user_id, date, avg_recovery_score, avg_sleep_score, recovery_trend FROM user_analytics ORDER BY date DESC LIMIT 10;"
}

echo "✅ Supabase CLI helpers loaded!"
echo ""
echo "Available commands:"
echo "  supabase-db                 - Connect to database"
echo "  supabase-tables             - List all tables"
echo "  supabase-query 'SQL'        - Run SQL query"
echo "  supabase-users              - View recent users"
echo "  supabase-providers          - View connected providers"
echo "  supabase-metrics-count      - Count health metrics"
echo "  supabase-messages           - View recent messages"
echo "  supabase-analytics          - View analytics"
