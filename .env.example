# Whoop API Credentials
# Get these from https://developer.whoop.com/dashboard
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
# Redirect URI MUST match what you registered in WHOOP Developer Dashboard
# Development: http://localhost:5001/api/oauth/whoop/callback
# Production: https://yourdomain.com/api/oauth/whoop/callback
WHOOP_REDIRECT_URI=http://localhost:5001/api/oauth/whoop/callback
WHOOP_ACCESS_TOKEN=your_access_token_here
WHOOP_REFRESH_TOKEN=your_refresh_token_here

# Google Gemini API
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio SMS Credentials
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
YOUR_PHONE_NUMBER=+1234567890

# Optional: User preferences
USER_NAME=Tharun
NOTIFICATION_TIME=08:00
TIMEZONE=America/New_York

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase Configuration
# Get these from your Supabase project settings
# https://supabase.com/dashboard
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
